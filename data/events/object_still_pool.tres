[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 1
text = "Tiny pale shrimp dart through the water. Something lives in it — that's a good sign, mostly."

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Look closer"
time_cost = 3
investigation = true
outcomes = Array[EventOutcome]([SubResource("o1_0")])

[resource]
script = ExtResource("event")
prop = ExtResource("prop")
kind = 4
title = "A still pool"
clue = "Black water fills a hollow in the floor, perfectly still. It smells faintly of iron."
