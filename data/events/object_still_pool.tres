[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 2
text = "Cold and clean. Strength seeps back slowly."
heal_over_time = 4

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 1
text = "It tastes of rust and rot. Your stomach turns."
health = -1
strain = 10.0

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Drink"
time_cost = 2
