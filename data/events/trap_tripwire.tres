[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="PackedScene" path="res://art/props/room-states-v1/tripwire.tscn" id="prop"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 3
text = "You ease over a taut wire. Nothing happens."

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 1
text = "Your heel catches the wire. Stones crash down from above!"
health = -3
strain = 5.0

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Step over carefully"
time_cost = 2
outcomes = Array[EventOutcome]([SubResource("o0_0"), SubResource("o0_1")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 3
text = "The wire parts with a twang. Overhead, a net of stones sags harmlessly."

[sub_resource type="Resource" id="o1_1"]
script = ExtResource("outcome")
weight = 1
text = "The wire snaps back and the stones come down anyway!"
health = -4
strain = 5.0

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Cut the wire"
time_cost = 3
outcomes = Array[EventOutcome]([SubResource("o1_0"), SubResource("o1_1")])

[resource]
script = ExtResource("event")
prop = ExtResource("prop")
kind = 3
title = "A tripwire"
clue = "The floor here is too clean, as if someone swept it. Something catches the lantern light at ankle height."
choices = Array[EventChoice]([SubResource("c0"), SubResource("c1")])
min_depth = 1
max_depth = 99
weight = 3
