[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 3
text = "You ease over a taut wire. Nothing happens."

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
text = "Your heel catches the wire. Stones crash down from above!"
stirs = true
health = -3
strain = 5.0

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Step over carefully"
time_cost = 2
outcomes = Array[ExtResource("outcome")]([SubResource("o0_0"), SubResource("o0_1")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 3
text = "The wire parts with a twang. Overhead, a net of stones sags harmlessly."

[sub_resource type="Resource" id="o1_1"]
script = ExtResource("outcome")
text = "The wire snaps back and the stones come down anyway!"
health = -4
strain = 5.0

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Cut the wire"
time_cost = 3
outcomes = Array[ExtResource("outcome")]([SubResource("o1_0"), SubResource("o1_1")])

[sub_resource type="Resource" id="Resource_11k3s"]
script = ExtResource("outcome")
text = "Your heel catches a wire you never saw. Stones crash down from above!"
stirs = true
health = -3
strain = 5.0

[resource]
script = ExtResource("event")
kind = 3
title = "A tripwire"
clue = "The floor here is too clean, as if someone swept it. Something catches the lantern light at ankle height."
choices = Array[ExtResource("choice")]([SubResource("c0"), SubResource("c1")])
