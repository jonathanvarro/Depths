[resource]
script = ExtResource("event")
kind = 4
title = "The main sluice"
clue = "A massive iron wheel set into a wall of carved stone. Behind it, through the gaps, water moves - a great weight of it, held back. The wheel is rusted, but not seized."
choices = Array[ExtResource("choice")]([SubResource("c0")])
min_depth = 99
