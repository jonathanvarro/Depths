[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
text = "Everyone puts their shoulder to it. The wheel groans, gives, and turns. Somewhere far off, stone grinds on stone - and the black water around your boots begins, slowly, to fall."
