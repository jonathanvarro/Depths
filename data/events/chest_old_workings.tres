[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]
[ext_resource type="Resource" path="res://data/items/copper_ore.tres" id="ore"]
[ext_resource type="Resource" path="res://data/items/gold_nuggets.tres" id="nuggets"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 3
text = "The rusted pick still bites. Two lumps of green-streaked ore come free."
loot = Dictionary[SupplyItem, int]({ExtResource("ore"): 2})

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 1
text = "The rock gives way all at once. Stones rain down on your shoulders."
health = -2
strain = 6.0
loot = Dictionary[SupplyItem, int]({ExtResource("ore"): 1})

[sub_resource type="Resource" id="o0_2"]
script = ExtResource("outcome")
weight = 1
text = "A glint deep in the seam. Gold - only a little, but gold."
loot = Dictionary[SupplyItem, int]({ExtResource("nuggets"): 1, ExtResource("ore"): 1})

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Dig out the ore"
time_cost = 4
outcomes = Array[EventOutcome]([SubResource("o0_0"), SubResource("o0_1"), SubResource("o0_2")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 1
text = "Beneath the tools, wrapped in a miner's scarf: a few old coins."
gold = 3

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Search the abandoned tools"
time_cost = 2
investigation = true
outcomes = Array[EventOutcome]([SubResource("o1_0")])

[resource]
script = ExtResource("event")
kind = 2
title = "Old workings"
clue = "A seam of green-streaked rock, half dug out. A rusted pick and a split basket lie where someone dropped them."
choices = Array[EventChoice]([SubResource("c0"), SubResource("c1")])
min_depth = 1
max_depth = 99
weight = 2
