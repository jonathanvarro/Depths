[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="PackedScene" path="res://art/props/damp-sites-v1/sunken-satchel.tscn" id="prop"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]
[ext_resource type="Resource" path="res://data/items/ration.tres" id="ration"]
[ext_resource type="Resource" path="res://data/items/oil_flask.tres" id="oil"]
[ext_resource type="Resource" path="res://data/enemies/leech_swarm.tres" id="leeches"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 4
text = "Cold to the elbow, you drag it out. Inside, wrapped in waxed cloth: food that kept, and a stoppered flask of oil."
loot = Dictionary[SupplyItem, int]({ExtResource("ration"): 1, ExtResource("oil"): 1})

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 2
text = "The flap tears and most of it is pulp. A little coin had sunk to the bottom."
gold = 6

[sub_resource type="Resource" id="o0_2"]
script = ExtResource("outcome")
weight = 1
text = "Something black and soft was living in it. The leeches come with it out of the water."
ambush = Array[EnemyType]([ExtResource("leeches")])

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Reach in"
time_cost = 2
outcomes = Array[EventOutcome]([SubResource("o0_0"), SubResource("o0_1"), SubResource("o0_2")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 1
text = "A miner's pack, half sunk in silt. The buckles are green, the leather swollen. Nobody's come back for it in a long time. Something might still be dry inside."

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Look closer"
time_cost = 1
investigation = true
outcomes = Array[EventOutcome]([SubResource("o1_0")])

[resource]
script = ExtResource("event")
prop = ExtResource("prop")
kind = 4
title = "A sunken satchel"
clue = "A pack lies half under the still water, its flap tied down."
choices = Array[EventChoice]([SubResource("c0"), SubResource("c1")])
min_depth = 2
max_depth = 2
weight = 2
areas = Array[String](["damp"])
