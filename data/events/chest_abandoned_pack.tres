[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]
[ext_resource type="Resource" path="res://data/items/oil_flask.tres" id="oil"]
[ext_resource type="Resource" path="res://data/items/ration.tres" id="ration"]
[ext_resource type="Resource" path="res://data/items/dressing.tres" id="dressing"]
[ext_resource type="Resource" path="res://data/enemies/rat.tres" id="rat"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 3
text = "Wrapped in oilcloth at the bottom: a flask of lamp oil."
loot = Dictionary[SupplyItem, int]({ExtResource("oil"): 1})

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 2
text = "A stale ration and a roll of clean linen."
loot = Dictionary[SupplyItem, int]({ExtResource("ration"): 1, ExtResource("dressing"): 1})

[sub_resource type="Resource" id="o0_2"]
script = ExtResource("outcome")
weight = 1
text = "Something inside squirms — a rat bursts out, teeth first!"
ambush = Array[EnemyType]([ExtResource("rat")])

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Search it"
time_cost = 2
outcomes = Array[EventOutcome]([SubResource("o0_0"), SubResource("o0_1"), SubResource("o0_2")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 1
text = "The pack shudders. A rat tumbles out, furious."
ambush = Array[EnemyType]([ExtResource("rat")])

[sub_resource type="Resource" id="o1_1"]
script = ExtResource("outcome")
weight = 2
text = "Nothing moves. Whatever chewed the strap is long gone."

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Prod it with your knife first"
time_cost = 3
investigation = true
outcomes = Array[EventOutcome]([SubResource("o1_0"), SubResource("o1_1")])

[resource]
script = ExtResource("event")
kind = 2
title = "An abandoned pack"
clue = "A torn pack lies against the wall, half buried in grit. One strap has been chewed through."
choices = Array[EventChoice]([SubResource("c0"), SubResource("c1")])
min_depth = 1
max_depth = 99
weight = 3
