[sub_resource type="Resource" id="Resource_tx1of"]
script = ExtResource("2_dexyg")
weight = 2
text = "Most of what hangs here has rusted through, but one mattock is still sound, its haft dark with old hands."
gear = Array[ExtResource("4_her7e")]([ExtResource("5_bolrv")])

[sub_resource type="Resource" id="Resource_1xqvn"]
script = ExtResource("2_dexyg")
weight = 2
text = "Behind the rotten picks hangs a miner's sledge, its iron head still true."
gear = Array[ExtResource("4_her7e")]([ExtResource("7_47h8i")])

[sub_resource type="Resource" id="Resource_5yjw4"]
script = ExtResource("2_dexyg")
text = "Only a short miner's pick is fit to use. Not much in a fight, but it works a seam or breaks through fallen rock."
loot = Dictionary[ExtResource("6_grg5b"), int]({
ExtResource("8_ehmtx"): 1
})

[sub_resource type="Resource" id="Resource_r18tg"]
script = ExtResource("1_ks6f4")
label = "Take what's still good"
time_cost = 2
outcomes = Array[ExtResource("2_dexyg")]([SubResource("Resource_tx1of"), SubResource("Resource_1xqvn"), SubResource("Resource_5yjw4")])

[sub_resource type="Resource" id="Resource_8ocbg"]
script = ExtResource("2_dexyg")
text = "A few lumps of coal the miners never burned. The merchant will pay a little for them."
loot = Dictionary[ExtResource("6_grg5b"), int]({
ExtResource("9_ym1kh"): 2
})

[sub_resource type="Resource" id="Resource_iis52"]
script = ExtResource("1_ks6f4")
