[resource]
script = ExtResource("9_8mpuk")
kind = 4
title = "Dead lamps"
clue = "An old lamp store. Every lamp is dead - glass smashed, wicks gnawed, the oil licked dry - and moth-wings drift in the dust. Something here drinks light. On a high shelf, sealed flasks still glint."
