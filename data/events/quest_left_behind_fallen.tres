[sub_resource type="Resource" id="Resource_nji8p"]
script = ExtResource("2_ibj3p")
text = "The guide, the surveyor, the two porters. None of them ran. Whatever came, it came from both sides at once."

[sub_resource type="Resource" id="Resource_q2qta"]
script = ExtResource("1_8ei27")
label = "Look them over"
investigation = true
outcomes = Array[ExtResource("2_ibj3p")]([SubResource("Resource_nji8p")])

[sub_resource type="Resource" id="Resource_887wi"]
script = ExtResource("2_ibj3p")
text = "The survey map is rolled tight in its case - and someone has marked it in a hand none of your party used. Wedged under the guide is an arrow: a goblin shaft, fletched with something black and glossy that no goblin you know would use."
quest = "left_behind"
quest_flag = "found"

[sub_resource type="Resource" id="Resource_xiv6q"]
script = ExtResource("1_8ei27")
label = "Gather their maps and anything strange"
time_cost = 3
outcomes = Array[ExtResource("2_ibj3p")]([SubResource("Resource_887wi")])

[resource]
script = ExtResource("7_62vov")
title = "Where they fell"
clue = "The rest of your party lies where the ambush caught them. Rats have been at the packs. A survey case lies open beside the guide's hand."
choices = Array[ExtResource("1_8ei27")]([SubResource("Resource_q2qta"), SubResource("Resource_xiv6q")])
min_depth = 99
prop = ExtResource("6_48mm3")
