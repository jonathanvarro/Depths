[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
text = "You're across before the floor can decide."

[sub_resource type="Resource" id="o1_1"]
script = ExtResource("outcome")
text = "The floor gives way and you drop hard onto broken stone."
