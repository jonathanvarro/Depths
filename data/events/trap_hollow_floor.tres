[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 3
text = "Slow going, but you find the solid stones."

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
text = "A slab tilts under you and your ankle twists."
