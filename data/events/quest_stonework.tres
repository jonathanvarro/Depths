[resource]
script = ExtResource("event")
kind = 4
title = "Old stonework"
clue = "Carved stone at the water's edge, older than anything above: not dwarf work, not human, not goblin. The carving is worn almost smooth, as if by hands. It is warm. It should not be warm."
choices = Array[ExtResource("choice")]([SubResource("c0")])
min_depth = 99
