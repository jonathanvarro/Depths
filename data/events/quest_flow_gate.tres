[ext_resource type="PackedScene" path="res://art/props/story-slice-v1/lower-water-gate.tscn" id="prop"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
text = "Hand over hand, the gate rises. The reservoir shudders, then begins to pour away through the outflow with a sound like a long breath let out. The level drops, and drops, and keeps dropping."
target = 1
strain = 6.0
quest = "reservoir"
quest_flag = "diverted"
quest_stage = 2
drains = true

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Haul the chains"
time_cost = 4
outcomes = Array[ExtResource("outcome")]([SubResource("o0_0")])

[resource]
script = ExtResource("event")
kind = 4
title = "The flow gate"
clue = "A gate of black iron as wide as a cart, set across the reservoir's outflow. Chains run up into the dark. Beyond it the water stands still and deep, and somewhere out in it, something large turns over and is quiet again."
choices = Array[ExtResource("choice")]([SubResource("c0")])
min_depth = 99
prop = ExtResource("prop")
