[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]

[sub_resource type="Resource" id="o0_0"]
script = ExtResource("outcome")
weight = 2
text = "Warmth spreads through your hands. Your breathing slows."
strain = -15.0

[sub_resource type="Resource" id="o0_1"]
script = ExtResource("outcome")
weight = 1
text = "Whispers crowd into your head. You snatch your hand away."
strain = 15.0

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Touch it"
time_cost = 1
outcomes = Array[EventOutcome]([SubResource("o0_0"), SubResource("o0_1")])

[sub_resource type="Resource" id="o1_0"]
script = ExtResource("outcome")
weight = 1
text = "Hands have rubbed it smooth over many years. Most who touched it, you suspect, left calmer."

[sub_resource type="Resource" id="c1"]
script = ExtResource("choice")
label = "Study it"
time_cost = 4
investigation = true
outcomes = Array[EventOutcome]([SubResource("o1_0")])

[resource]
script = ExtResource("event")
kind = 4
title = "A pale idol"
clue = "A small figure of pale stone sits in a niche, worn smooth by many hands. The air around it is strangely warm."
choices = Array[EventChoice]([SubResource("c0"), SubResource("c1")])
min_depth = 1
max_depth = 99
weight = 2
