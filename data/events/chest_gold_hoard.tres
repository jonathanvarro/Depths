[gd_resource type="Resource" script_class="RoomEvent" format=3]

[ext_resource type="Script" path="res://scripts/room_event.gd" id="event"]
[ext_resource type="PackedScene" path="res://art/props/expedition-3d-v1/chest.tscn" id="prop"]
[ext_resource type="Script" path="res://scripts/event_choice.gd" id="choice"]
[ext_resource type="Script" path="res://scripts/event_outcome.gd" id="outcome"]

[sub_resource type="Resource" id="open"]
script = ExtResource("outcome")
text = "Gilt flakes from the lid as it rises. Whatever kept this hoard, it killed for it."

[sub_resource type="Resource" id="c0"]
script = ExtResource("choice")
label = "Open it"
time_cost = 1
outcomes = Array[EventOutcome]([SubResource("open")])

[resource]
script = ExtResource("event")
kind = 2
title = "A gilded chest"
clue = "A chest banded in old gold, dented and blood-flecked. A hoard, guarded until moments ago."
choices = Array[EventChoice]([SubResource("c0")])
min_depth = 99
max_depth = 99
weight = 1
prop = ExtResource("prop")
