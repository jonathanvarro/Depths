[gd_resource type="Resource" script_class="PortraitSet" format=3]

[ext_resource type="Script" path="res://scripts/portrait_set.gd" id="script"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/body.png" id="body"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/head-clean.png" id="head"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/eyes-neutral.png" id="eyes"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/mouth-neutral.png" id="mouth"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/eyes-half.png" id="eyes-half"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/eyes-closed.png" id="eyes-closed"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/mouth-small.png" id="mouth-small"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/mouth-open.png" id="mouth-open"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/blood.png" id="blood"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/dirt.png" id="dirt"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/bandage.png" id="bandage"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/pallor.png" id="pallor"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/shadow-left.png" id="shadow-left"]
[ext_resource type="Texture2D" path="res://art/portraits/fixer-v1/fixer-b/highlight-left.png" id="highlight-left"]

[resource]
script = ExtResource("script")
rig_kind = "Unique"
rig_family = &"unique-fixer-b-v1"
face_id = &"fixer-b"
body = ExtResource("body")
head = ExtResource("head")
eyes = ExtResource("eyes")
mouth = ExtResource("mouth")
conditions = {"blood": ExtResource("blood"), "dirt": ExtResource("dirt"), "bandage": ExtResource("bandage"), "pallor": ExtResource("pallor")}
blink_frames = Array[Texture2D]([ExtResource("eyes-half"), ExtResource("eyes-closed")])
talk_frames = Array[Texture2D]([ExtResource("mouth-small"), ExtResource("mouth-open")])
light_shadow = ExtResource("shadow-left")
light_highlight = ExtResource("highlight-left")
