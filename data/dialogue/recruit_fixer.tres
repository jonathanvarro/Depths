[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"fight_start": PackedStringArray("Right. Somebody else go first.", "I'll keep to the back - it's where the money is.", "Mind the merchandise."), "fight_won": PackedStringArray("Anything worth selling on that?", "Good. Now, about the loot.", "Told you we'd manage."), "hurt": PackedStringArray("That'll cost someone.", "I'm hit. Not a good investment, this.", "Keep them off me!"), "shaken": PackedStringArray("This place is bad for business.", "I don't like the odds down here.", "Something's watching. I can feel the price going up."), "panic": PackedStringArray("I'm out - I'm out - this isn't worth it!", "No amount of gold is worth this!"), "camp_return": PackedStringArray("Daylight, and something to sell. Not bad.", "Let me do the talking at the merchant.", "Home with our skins. And a profit, I hope."), "camp_hurt": PackedStringArray("Nothing a few coins at the nurse won't fix.", "I'll heal. Expensively."), "camp_grief": PackedStringArray("{fallen} owed me nothing, and I'd give it all back.", "I keep doing the sums without {fallen}. They don't work."), "need_hunger": PackedStringArray("We can't haggle with an empty stomach. Food?", "Rations. Now. I'll pay you back."), "need_nerves": PackedStringArray("Light, food, a rest - I'd trade anything for one of them.", "This is wearing thin."), "need_hurt": PackedStringArray("Somebody bind this before it costs more.", "Still bleeding. Not ideal."), "need_light": PackedStringArray("Light's going. That's the one thing I can't sell us out of.", "Oil, or a torch - before it's too dark to count."), "ally_down": PackedStringArray("{fallen}'s down - someone do something useful!", "That's {fallen} - I'm not built for this!"), "level_ready": PackedStringArray("I'm learning the price of things down there. Including us.", "Getting better at not dying. Valuable skill."), "memory_rescued": PackedStringArray("{who} pulled me out. Remind me to undercharge {who}.", "I owe {who}. I hate owing."), "memory_close_call": PackedStringArray("I nearly settled every account today.", "Close. Far too close for what they pay me."), "memory_slew": PackedStringArray("The {foe}'s dead. Someone will pay well to hear that.", "We killed the {foe}. I'll be telling it for coin.")})
