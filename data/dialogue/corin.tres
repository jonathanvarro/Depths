[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"wake": PackedStringArray("Ugh. Who hit me? ...Goblins. Of course.", "Get up, soldier. Up.", "My head's split open. Good. Means it's still on."), "bodies": PackedStringArray("Dead. All of them. The vanguard, my arse.", "You stupid... you should have run. I told you to run.", "I'll make them pay for you. Every last one."), "bleeding": PackedStringArray("I'm leaking like a cracked barrel.", "Blood. Mine, this time.", "Bleeding's just weakness leaving. Slowly. All of it."), "find_exit": PackedStringArray("There's a way out. Goblins don't live where there's no way out.", "Find the exit. Then come back with a proper army.", "Up. Always up."), "lost": PackedStringArray("Every tunnel looks the same. Like goblins.", "Left, right - who digs like this?", "I've walked this rock before. I'm sure of it."), "web": PackedStringArray("Webs. Wonderful. Spiders as well as goblins.", "I'll tear it down with my teeth if I have to.", "Disgusting. In my mouth. In my MOUTH."), "fight_start": PackedStringArray("Come on then!", "Finally, something to hit.", "You'll do."), "fight_won": PackedStringArray("Is that all?", "Next.", "That felt good. Shouldn't have. Did."), "hurt": PackedStringArray("Not dead yet. Not yet.", "Keep your feet, you old fool.", "I've had worse. I think."), "panic": PackedStringArray("I can't see - where are they? WHERE?", "Breathe. Soldiers breathe.", "Not like this. Not in the dark."), "dark": PackedStringArray("Can't see a damned thing.", "The light's going. Bad. Very bad."), "daylight": PackedStringArray("Daylight. Ha! Daylight!", "Air. Real air.", "Out. Out, out, out."), "too_dark": PackedStringArray("Too dark. I'd walk straight onto a goblin spear.", "Not without a light. I'm stubborn, not stupid.", "Their packs. They'll have a torch."), "search_body": PackedStringArray("Sorry, lad. You won't need it.", "Your sword, your torches. I'll put them to work.", "Rest. I'll do the killing for both of us."), "torch_lit": PackedStringArray("Light. Now they can see me coming. Good.", "There. Let them come."), "torch_out": PackedStringArray("The torch! No, no -", "Burnt out. The spare, where's the spare?"), "throw_torch": PackedStringArray("Burn!", "Have it, then!"), "explore": PackedStringArray("Dead end. Naturally.", "Who digs a tunnel to nowhere?", "Back. Again.", "I hate caves. Hated them before, too."), "web2": PackedStringArray("Another web. Bigger. Something's been eating well.", "More webs. Lovely.", "Whatever spins these, I'll squash it."), "chest_seen": PackedStringArray("A chest. Maybe someone down here had sense.", "There - something in the wall."), "chest": PackedStringArray("Let's see what the dead left me.", "Rusty. Like me."), "trip": PackedStringArray("Gah - my foot - the torch!", "Stupid rock! The light!"), "spider_glance": PackedStringArray("It's like hitting a cooking pot!", "My blade just bounces off!", "Hit it! Why won't it - HIT IT!"), "forced_throw": PackedStringArray("Fine! Have the fire!", "Back, you eight-legged -"), "fire": PackedStringArray("Fire's dying. Like everyone else down here.", "Warm. For a moment."), "camp_return": PackedStringArray("Alive. Mark it down.", "Back. Feed me before you debrief me.", "Another trip, another debt they owe us."), "camp_hurt": PackedStringArray("Stitch it and don't fuss.", "I've had worse. Haven't I?"), "camp_grief": PackedStringArray("{fallen} died on my watch. Again. Again.", "Put {fallen}'s name with the others."), "need_hunger": PackedStringArray("Anyone else starving? I could eat a rat. Don't tempt me.", "Food. Now. Before I get mean."), "need_nerves": PackedStringArray("Don't like this place. Don't like it at all.", "Every shadow's got teeth today."), "need_hurt": PackedStringArray("I've had worse. Not much worse.", "Someone bind this before I fall over."), "need_light": PackedStringArray("Can't hit what I can't see. Light, someone.", "That light's dying.")})
