[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"wake": PackedStringArray("...where... no. No, no, no.", "My head... what happened?", "Get up. Get up, Mara.", "Cold. So cold. Where's the light coming from?"), "bodies": PackedStringArray("I'm sorry. I'm so sorry. I led you here.", "They're gone. I can't help them now.", "I'll come back for you. I swear it.", "Bren... Tomas... wake up. Please."), "bleeding": PackedStringArray("I'm bleeding... badly. Keep moving.", "So much blood. I can't stop.", "It won't stop bleeding. I have to hurry.", "My side - it's soaking through."), "find_exit": PackedStringArray("There has to be a way out.", "I need to find the exit. Now.", "Up. The way out is up somewhere.", "Air moves somewhere down here. Follow it."), "lost": PackedStringArray("Which way? It all looks the same.", "Have I been here before?", "Left... right... I don't know any more.", "These tunnels twist back on themselves."), "web": PackedStringArray("Webs. Something lives down here.", "Ugh - it's in my hair.", "Tear through. Don't think about what spun it."), "fight_start": PackedStringArray("Get back!", "Stay away from me!", "Not now - not like this."), "fight_won": PackedStringArray("It's dead. Keep going.", "Breathe. Just breathe.", "There'll be more of them."), "hurt": PackedStringArray("I can't take much more.", "My legs... keep moving.", "Everything is going grey."), "panic": PackedStringArray("I can't... I can't breathe.", "My hands won't stop shaking.", "Calm down. Calm down!"), "dark": PackedStringArray("The light's going... no, no.", "I can't see a thing."), "daylight": PackedStringArray("Is that... daylight?", "Air. Fresh air!", "Almost there. Almost."), "too_dark": PackedStringArray("It's too dark. I can't go on without a light.", "I won't last a minute out there blind.", "I need light first. Their packs...", "Past the fire it's black as pitch."), "search_body": PackedStringArray("Forgive me.", "I need this more than you do now. I'm sorry.", "Rest. I'll carry it.", "Your torches. Your sword. I'll put them to use."), "torch_lit": PackedStringArray("Light. Thank the gods.", "There. I can see again.", "Hold it steady. Don't drop it."), "torch_out": PackedStringArray("No - the torch is dying!", "It's burning out... the spare, where's the spare?"), "throw_torch": PackedStringArray("Get away from me!", "Burn, then!"), "explore": PackedStringArray("Dead end. Back, then.", "I don't remember coming this way.", "Every passage looks like the last one.", "Slow down. Look properly."), "web2": PackedStringArray("Another web - thicker. Whatever spun these is big.", "More webs. I'm getting close to something.", "The air's colder past this one."), "chest_seen": PackedStringArray("A chest? Someone left supplies down here.", "There - something in the wall."), "chest": PackedStringArray("Please, let there be something useful.", "Old, but it opens."), "trip": PackedStringArray("No! The torch!", "Agh - my ankle - the light!"), "spider_glance": PackedStringArray("It's like hitting stone!", "My blade won't bite!", "It's too tough - I can't hurt it!"), "forced_throw": PackedStringArray("I can't... I need the fire!", "The torch - it's all I've got!"), "fire": PackedStringArray("The fire won't last much longer.", "Warmth. For a moment."), "camp_return": PackedStringArray("Daylight again. I'll never get used to it.", "We came back. Not everyone does.", "Rest. Then I'm going back down."), "camp_hurt": PackedStringArray("I'll mend. I always do.", "Bandage it tight. I need to walk."), "camp_grief": PackedStringArray("{fallen} trusted me to lead them out.", "I'll remember {fallen}. Someone has to.")})
