[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"wake": PackedStringArray("...where... no. No, no, no.", "My head... what happened?", "Get up. Get up, Mara."), "bodies": PackedStringArray("I'm sorry. I'm so sorry. I led you here.", "They're gone. I can't help them now.", "I'll come back for you. I swear it."), "bleeding": PackedStringArray("I'm bleeding... badly. Keep moving.", "So much blood. I can't stop.", "It won't stop bleeding. I have to hurry."), "find_exit": PackedStringArray("There has to be a way out.", "I need to find the exit. Now.", "Up. The way out is up somewhere."), "lost": PackedStringArray("Which way? It all looks the same.", "Have I been here before?", "Left... right... I don't know any more."), "web": PackedStringArray("Webs. Something lives down here.", "Ugh - it's in my hair.", "Tear through. Don't think about what spun it."), "fight_start": PackedStringArray("Get back!", "Stay away from me!", "Not now - not like this."), "fight_won": PackedStringArray("It's dead. Keep going.", "Breathe. Just breathe.", "There'll be more of them."), "hurt": PackedStringArray("I can't take much more.", "My legs... keep moving.", "Everything is going grey."), "panic": PackedStringArray("I can't... I can't breathe.", "My hands won't stop shaking.", "Calm down. Calm down!"), "dark": PackedStringArray("The light's going... no, no.", "I can't see a thing."), "daylight": PackedStringArray("Is that... daylight?", "Air. Fresh air!", "Almost there. Almost."), "too_dark": PackedStringArray("It's too dark. I can't go on without a light.", "I won't last a minute out there blind.", "I need light first. Their packs..."), "search_body": PackedStringArray("Forgive me.", "I need this more than you do now. I'm sorry.", "Rest. I'll carry it."), "torch_lit": PackedStringArray("Light. Thank the gods.", "There. I can see again."), "torch_out": PackedStringArray("No - the torch is dying!", "It's burning out... the spare, where's the spare?"), "throw_torch": PackedStringArray("Get away from me!", "Burn, then!")})
