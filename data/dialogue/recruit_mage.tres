[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"fight_start": PackedStringArray("Stand behind me. No, wait. In front.", "I've read about these. Not enough, it turns out.", "Keep it off me and I'll see what I can do."), "fight_won": PackedStringArray("Noted. Written down later, if my hands stop shaking.", "That went better than the books suggested.", "Still breathing. Good."), "hurt": PackedStringArray("That's... a lot of blood. Mine, I think.", "I'm not built for this part.", "Bandage. Please. Now."), "shaken": PackedStringArray("The walls are too close. They weren't this close before.", "Something's watching. I know how that sounds.", "I can't think straight down here."), "panic": PackedStringArray("No - no - I need to get OUT -", "Let me through! I can't - I can't -"), "camp_return": PackedStringArray("Air. Real air. I'd forgotten.", "I have notes. So many notes.", "Back with everything I went down with. Mostly."), "camp_hurt": PackedStringArray("Stitches before study, I suppose.", "I'll heal. Slowly. I always do things slowly."), "camp_grief": PackedStringArray("{fallen} knew the way better than any map. We lost that.", "I keep writing {fallen}'s name. I don't know why."), "need_hunger": PackedStringArray("I can't concentrate on an empty stomach.", "When did we last eat? I've lost count."), "need_nerves": PackedStringArray("I need a moment. Just a moment.", "My hands won't stop shaking."), "need_hurt": PackedStringArray("This needs looking at. I'd rather not look myself.", "It's still bleeding. Is that normal?"), "need_light": PackedStringArray("I can't read the walls in this dark.", "The light's failing. Fix it, please."), "ally_down": PackedStringArray("{fallen}! No - get up, get up -", "{fallen}'s down. Do something! I mean - I'll do something."), "level_ready": PackedStringArray("It's starting to make sense. All of it.", "I see more clearly down here. Strange."), "memory_rescued": PackedStringArray("{who} pulled that thing off me. I'll remember.", "If not for {who}, I'd be a footnote."), "memory_close_call": PackedStringArray("That was closer than I like. I don't like any of it.", "I nearly didn't come back. I'm writing that down."), "memory_slew": PackedStringArray("We killed the {foe}. I'll need a new chapter.", "The {foe}. Gone. I watched it fall."), "torch_out": PackedStringArray("The torch! It's going out!", "Light - we need another light!"), "torch_lit": PackedStringArray("Better. Much better.", "There. Now I can see what's trying to kill us."), "dark": PackedStringArray("I can't see. I can't see anything.", "Don't move. Let me think. In the dark. Wonderful.")})
