[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"fight_start": PackedStringArray("Behind me. Stay behind me.", "Arms up. Hold the line.", "Hold. Let them come to us."), "fight_won": PackedStringArray("Everyone still standing? Good.", "Done. Check your wounds.", "That's them seen off."), "hurt": PackedStringArray("I'm cut. Still standing. Keep going.", "I can take another. Not many.", "I'll hold - but don't make me hold long."), "shaken": PackedStringArray("Steady. I said steady. That was for me.", "Something's watching us. I can feel it.", "Keep close. I don't like this."), "panic": PackedStringArray("I can't - I can't hold it -", "Too many. Too dark. Too -"), "camp_return": PackedStringArray("Everyone back. That's the job.", "Fire. Food. Then we go again.", "Good work down there."), "camp_hurt": PackedStringArray("Patch me up. I'll be standing by morning.", "Took a few for the rest of you. Worth it."), "camp_grief": PackedStringArray("I should have been in front of {fallen}. I should have been.", "{fallen} was mine to keep. I didn't."), "need_hunger": PackedStringArray("We'll fight better fed. Rations.", "Hungry. Let's eat while it's quiet."), "need_nerves": PackedStringArray("Steady. We need light, food, rest.", "The dark's wearing on us all."), "need_hurt": PackedStringArray("This wound wants a dressing.", "I'll hold, but not forever like this."), "need_light": PackedStringArray("Light's low. Fix it before something finds us.", "We need the lamp bright."), "ally_down": PackedStringArray("{fallen} is down - on me, everyone on me!", "I lost {fallen}. Not the rest. Not the rest of you."), "level_ready": PackedStringArray("I can hold longer now. Let them come.", "Learned something down there. I'll show you."), "memory_rescued": PackedStringArray("{who} got me loose. I'm meant to be the one doing that.", "{who} stood for me. I'll stand twice as long for them."), "memory_close_call": PackedStringArray("I nearly didn't hold today. Nearly.", "Shield's dented. So am I. Still here."), "memory_slew": PackedStringArray("We held, and the {foe} didn't. That's the job.", "The {foe} broke on us. Good.")})
