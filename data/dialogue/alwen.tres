[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"wake": PackedStringArray("Breathe. Count your breaths. One. Two.", "Where... oh. Oh, no.", "I'm alive. Then I have work to do."), "bodies": PackedStringArray("I was too slow. I'm so sorry.", "No pulse. Neither of them.", "I should have been with you. I could have done something."), "bleeding": PackedStringArray("A deep cut, under the ribs. I need to keep moving.", "I know exactly how much blood that is. Too much.", "Pressure. Keep pressure on it."), "find_exit": PackedStringArray("Find the way out, then find help.", "Up. The air's fresher above.", "There must be a way out. They got in."), "lost": PackedStringArray("I've lost my bearings.", "Have I passed this before?", "Every turning looks the same in this light."), "web": PackedStringArray("Webs. Mind your eyes.", "Something lives here. Something with fangs.", "Pull it away slowly. There."), "fight_start": PackedStringArray("Stay back!", "Please - stay away!", "I don't want to hurt you. I will."), "fight_won": PackedStringArray("It's over. Breathe.", "I'm shaking. Keep going.", "Check for wounds. Then move."), "hurt": PackedStringArray("I'm hurt worse than I'd let a patient walk on.", "Stay standing. Stay standing.", "My hands. Keep them steady."), "panic": PackedStringArray("I can't - I can't breathe -", "Steady. Steady. Like in the field.", "My heart's racing. Too fast."), "dark": PackedStringArray("The light's failing.", "I can't see my own hands."), "daylight": PackedStringArray("Daylight! Oh, thank the saints.", "Air. Clean air.", "Almost. Almost there."), "too_dark": PackedStringArray("It's pitch black out there. I'd break my neck.", "I need a light first.", "Their packs. They always carried torches."), "search_body": PackedStringArray("Forgive me. I'll keep you with me.", "You'd want me to take it. I know you would.", "Rest now. I'll carry this."), "torch_lit": PackedStringArray("Light. Good.", "There. Now I can see what I'm doing."), "torch_out": PackedStringArray("The torch is guttering!", "It's going out - the spare, quickly."), "throw_torch": PackedStringArray("Get away!", "Take it - go!"), "explore": PackedStringArray("A dead end. Back.", "I don't recognise this.", "Slow down. Look properly.", "Every passage looks like the last."), "web2": PackedStringArray("Another web. Larger.", "More webs. Careful now.", "Whatever made these is near."), "chest_seen": PackedStringArray("A chest - supplies, maybe?", "Over there. Something left behind."), "chest": PackedStringArray("Please be bandages.", "Old, but it opens."), "trip": PackedStringArray("No - the torch!", "My ankle - the light!"), "spider_glance": PackedStringArray("I can't even scratch it!", "It's armoured - like stone!", "Nothing gets through!"), "forced_throw": PackedStringArray("The fire - it's all I have!", "Back! Back with you!"), "fire": PackedStringArray("The fire won't last.", "A little warmth. A little.")})
