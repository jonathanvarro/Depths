[gd_resource type="Resource" script_class="DialogueLines" format=3]

[ext_resource type="Script" path="res://scripts/dialogue_lines.gd" id="1"]

[resource]
script = ExtResource("1")
lines = Dictionary[String, PackedStringArray]({"fight_start": PackedStringArray("I've got the angle!", "Stay still - I'll do the rest.", "Oh, here we go."), "fight_won": PackedStringArray("Clean. Mostly.", "Told you I'd get it.", "Somebody pick up my stones."), "hurt": PackedStringArray("That one got me. Watch my side.", "Bleeding. Not good for someone built like a twig.", "I'm hit. I'll keep back."), "shaken": PackedStringArray("Did you hear that? Tell me you heard that.", "I keep seeing things past the light.", "My hands won't stop shaking. Bad for aim."), "panic": PackedStringArray("I'm going - I can't stay here -", "Run. We should run. Why aren't we running?"), "camp_return": PackedStringArray("Sky! I missed you, sky.", "Not bad. Next time I sleep for a week first.", "Still got all my fingers. Counting is a good sign."), "camp_hurt": PackedStringArray("Somebody please tell me this'll scar nicely.", "I'll be quicker once this stops throbbing."), "camp_grief": PackedStringArray("{fallen} was right there. Right there. And then...", "I keep counting us. I keep getting it wrong. {fallen}..."), "need_hunger": PackedStringArray("Scouts run on bread. I'm out of bread.", "Is there food? Asking for my stomach."), "need_nerves": PackedStringArray("I keep seeing things past the light. Bad sign.", "A rest would help. A long one."), "need_hurt": PackedStringArray("Still hit. Somebody wrap it?", "This'll slow me down if it's left."), "need_light": PackedStringArray("I can't scout what I can't see.", "The light's thinning out."), "ally_down": PackedStringArray("{fallen}? {fallen}! Get up - please get up -", "They got {fallen}! Watch the flanks!"), "level_ready": PackedStringArray("I'm hearing things I didn't before. Good things. Mostly.", "Faster. Quieter. Getting there."), "memory_rescued": PackedStringArray("{who} pulled me out! I'm buying {who} whatever they want.", "If {who} hadn't swung, I'd be a stain."), "memory_close_call": PackedStringArray("I counted my heartbeats today. Got worryingly low.", "That close. Like, that close."), "memory_slew": PackedStringArray("We killed the {foe}! Us! I want that on my grave. Not soon.", "I've got a {foe} story now. You'll all hear it.")})
