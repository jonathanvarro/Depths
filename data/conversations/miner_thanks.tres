[sub_resource type="Resource" id="Resource_otes6"]
script = ExtResource("1_u438k")
text = "The miner you found behind the rubble is sitting at the fire, a blanket round his shoulders. \"They said it was you who heard me. I'd have died in there.\"

He leans in. \"There's good iron on the first floor - a dark seam with rust-red streaks, where the old workings end. The smith'd want it.\""

