[gd_resource type="Resource" script_class="Conversation" format=3]

[ext_resource type="Script" path="res://scripts/conversation_page.gd" id="page"]
[ext_resource type="Script" path="res://scripts/conversation_reply.gd" id="reply"]
[ext_resource type="Script" path="res://scripts/conversation.gd" id="conv"]
[ext_resource type="Texture2D" path="res://art/portraits/story-slice-v1/commander-edric.png" id="portrait"]

[sub_resource type="Resource" id="r0_0"]
script = ExtResource("reply")
next = 1

[sub_resource type="Resource" id="p0"]
script = ExtResource("page")
speaker = "narrator"
text = "He listens to all of it - the gate, the reservoir pouring away, the way down laid open beneath it - and for once he does not look at his map."
replies = Array[ExtResource("reply")]([SubResource("r0_0")])

[sub_resource type="Resource" id="r1_0"]
script = ExtResource("reply")
label = "Tell him everything"
next = 2
quest = "reservoir"
flag = "told_all"
said_by = {
"Corin": "\"Old stone, warm as a forge. And an elf who says it was her people who killed my company, not goblins.\"",
"Mara": "\"Stonework. Warm, like something breathing. And an elf among the pools, who said her people killed mine.\"",
"Sister Alwen": "\"Stone that's warm to the touch, with a beat in it. And a wounded elf who said her people killed ours.\""
}

[sub_resource type="Resource" id="r1_1"]
script = ExtResource("reply")
label = "Keep some of it back"
next = 4
quest = "reservoir"
flag = "kept_back"
said_by = {
"Corin": "\"The gate's done, the water's gone, the way down is open. That's the report.\"",
"Mara": "\"The gate held. The reservoir's gone. The way down is open.\"",
"Sister Alwen": "\"We opened the gate and the water went. The way down is clear.\""
}

[sub_resource type="Resource" id="p1"]
script = ExtResource("page")
text = "\"And below the water?\""
replies = Array[ExtResource("reply")]([SubResource("r1_0"), SubResource("r1_1")])

[sub_resource type="Resource" id="r2_0"]
script = ExtResource("reply")
next = 3

[sub_resource type="Resource" id="p2"]
script = ExtResource("page")
speaker = "narrator"
text = "He is very still. Then he smiles, for the first time since you have known him."
replies = Array[ExtResource("reply")]([SubResource("r2_0")])

[sub_resource type="Resource" id="r3_0"]
script = ExtResource("reply")
label = "Good?"
next = 6
said_by = {
"Corin": "\"Good? Good for who?\"",
"Mara": "\"...Good?\"",
"Sister Alwen": "\"Good? Commander, what is it?\""
}

[sub_resource type="Resource" id="p3"]
script = ExtResource("page")
text = "\"Alive,\" he says softly. \"Good.\""
replies = Array[ExtResource("reply")]([SubResource("r3_0")])

[sub_resource type="Resource" id="r4_0"]
script = ExtResource("reply")
next = 5

[sub_resource type="Resource" id="p4"]
script = ExtResource("page")
speaker = "narrator"
text = "He watches your face while you talk, the way a smith watches metal in the fire."
replies = Array[ExtResource("reply")]([SubResource("r4_0")])

[sub_resource type="Resource" id="r5_0"]
script = ExtResource("reply")
next = 6

[sub_resource type="Resource" id="p5"]
script = ExtResource("page")
text = "\"There is more,\" he says. It is not a question. \"There always is. Rest. We go deeper soon.\""
replies = Array[ExtResource("reply")]([SubResource("r5_0")])

[sub_resource type="Resource" id="p6"]
script = ExtResource("page")
speaker = "narrator"
text = "That night the camp is louder than usual: more soldiers have come down the road, and more are coming. Whatever the commander means to do below, he will not be doing it with one small party.\n\nThis is as far as the story goes for now."

[resource]
script = ExtResource("conv")
speaker = "Commander Edric Vael"
portrait = ExtResource("portrait")
pages = Array[ExtResource("page")]([SubResource("p0"), SubResource("p1"), SubResource("p2"), SubResource("p3"), SubResource("p4"), SubResource("p5"), SubResource("p6")])
