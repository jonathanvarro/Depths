[sub_resource type="Resource" id="Resource_wost7"]
script = ExtResource("1_u7262")
text = "He weighs the ore in both hands and grins for the first time since he arrived. \"Good iron. Proper iron.\" Two days of hammering later, a blade lies on his anvil, bright and light. \"It's yours to buy - I still have to eat.\""

