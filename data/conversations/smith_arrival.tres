[sub_resource type="Resource" id="Resource_h88mf"]
script = ExtResource("1_lsr1u")
text = "A thin young man is hammering a bent rail flat on a borrowed anvil. \"The quartermaster sent me with the last wagon. Apprentice smith. I've knives, clubs, a spear or two - plain things.\" He looks at your gear. \"Bring me something worth working, and I'll do better.\""

