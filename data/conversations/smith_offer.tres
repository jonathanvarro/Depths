[sub_resource type="Resource" id="r1_0"]
script = ExtResource("2_xf27s")
label = "I'll bring you iron"
next = -1
quest = "iron_sample"
stage = 2
said_by = {
"Corin": "\"I'll bring you iron. A good blade's worth the walk.\"",
"Mara": "\"I'll bring you iron. I know where the old workings are.\"",
"Sister Alwen": "\"I'll bring you iron, if the mine gives any up.\""
}
accepts = "iron_sample"

[sub_resource type="Resource" id="r1_1"]
script = ExtResource("2_xf27s")
label = "Maybe later"
next = -1
quest = "iron_sample"
stage = 1
said_by = {
"Corin": "\"Later. I've other business down there first.\"",
"Mara": "\"Maybe later.\"",
"Sister Alwen": "\"Maybe later. We've wounded to see to.\""
}

[sub_resource type="Resource" id="p1"]
script = ExtResource("1_k32ii")
text = "\"Everything they sent me is scrap. If I had real iron - even a fist-sized lump from a good seam - I could make you something better than what you're carrying.\""
replies = Array[ExtResource("2_xf27s")]([SubResource("r1_0"), SubResource("r1_1")])

[resource]
script = ExtResource("4_ryrp8")
speaker = "The apprentice smith"
