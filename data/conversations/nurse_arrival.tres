[sub_resource type="Resource" id="Resource_3a3f2"]
script = ExtResource("1_ich81")
text = "A woman in a patched apron is unpacking jars beside the far tent, sorting the bitter moss into neat bundles. \"You're the ones who brought this? Good. It's fresh.\""
