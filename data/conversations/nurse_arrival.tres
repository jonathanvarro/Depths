[sub_resource type="Resource" id="Resource_3n33b"]
script = ExtResource("1_ich81")
text = "\"I can dress what the mine does to you - the deep cuts, the bad legs. Some of it takes days to mend, and you'll go down without them while it does. Bring me your wounded.\""

