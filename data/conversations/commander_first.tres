[sub_resource type="Resource" id="Resource_tjfbn"]
script = ExtResource("3_j4kar")
label = "\"We were ambushed.\""
next = 1
quest = "story"
flag = "told_ambush"

[sub_resource type="Resource" id="Resource_4r1gf"]
script = ExtResource("3_j4kar")
label = "\"Not yet.\""
next = 2
quest = "story"
flag = "told_not_yet"

[sub_resource type="Resource" id="Resource_cjiw5"]
script = ExtResource("3_j4kar")
label = "\"Find what? They never told me.\""
next = 3
quest = "story"
flag = "asked_what"

[sub_resource type="Resource" id="Resource_6g6o8"]
script = ExtResource("2_r7od4")
text = "Soldiers in the king's colours stand at the mine entrance. Their commander steps forward: grey at the temples, armour scrubbed clean, eyes that miss nothing.

\"Edric Vael, commander of this expedition. You went down with the survey party. Tell me - did you find it?\""
replies = Array[ExtResource("3_j4kar")]([SubResource("Resource_tjfbn"), SubResource("Resource_4r1gf"), SubResource("Resource_cjiw5")])

[sub_resource type="Resource" id="Resource_4tdd2"]
script = ExtResource("3_j4kar")
next = 4

[sub_resource type="Resource" id="Resource_8u8d1"]
script = ExtResource("2_r7od4")
text = "\"Ambushed.\" He weighs the word. \"Rats bite. Spiders wait. Goblins raid - but an ambush means someone knew where you'd be.\" He glances at his officers, then back to you. \"Then I want to know who.\""
replies = Array[ExtResource("3_j4kar")]([SubResource("Resource_4tdd2")])

[sub_resource type="Resource" id="Resource_gimte"]
script = ExtResource("3_j4kar")
next = 4

[sub_resource type="Resource" id="Resource_obvxk"]
script = ExtResource("2_r7od4")
text = "\"Not yet.\" Something tightens at the corner of his mouth. \"Then the king's patience is the only thing in this valley that isn't running out.\""
replies = Array[ExtResource("3_j4kar")]([SubResource("Resource_gimte")])

[sub_resource type="Resource" id="Resource_lgnmi"]
script = ExtResource("3_j4kar")
next = 4

[sub_resource type="Resource" id="Resource_hr3q8"]
script = ExtResource("2_r7od4")
text = "\"They didn't tell you.\" A pause - not surprise, exactly. \"Good. Fewer tongues. You'll learn what you need when you need it, {hero}.\""
replies = Array[ExtResource("3_j4kar")]([SubResource("Resource_lgnmi")])

[sub_resource type="Resource" id="Resource_fflwa"]
script = ExtResource("3_j4kar")
label = "\"I'll find them.\""
quest = "left_behind"
stage = 2

[sub_resource type="Resource" id="Resource_moxlj"]
script = ExtResource("2_r7od4")
text = "\"Your party is still down there. Rest at the camp tonight. Then go back to the first floor, find where they fell, and bring me whatever they carried - every map, every scrap. Their families will want to know. So will I.\""
replies = Array[ExtResource("3_j4kar")]([SubResource("Resource_fflwa")])

