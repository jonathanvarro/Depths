[resource]
script = ExtResource("type")
display_name = "Hollow Interval"
scene = ExtResource("scene")
model = ExtResource("model")
max_health = 10
damage_min = 2
damage_max = 5
accuracy = 0.8
initiative = 14
injury_chance = 0.12
injuries = Array[ExtResource("injury_script")]([ExtResource("wound")])
attack_verb = "bites"
tactic = 15
intro = "A Hollow Interval: a hound-shaped absence, only grit outlining its jaw. It drinks your light - lantern oil or a torch's life - and bites in the dark it leaves. (Stand-in model until its own is made.)"
loot_line = "In the grit where the Hollow Interval was: %s."
threat = 4
family = "breach"
row = "front"
reach_back = false
fears_fire = true
